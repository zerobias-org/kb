# node-kvm-host configuration. Sourced by every script under host/ and bin/.
# Per-node settings live in nodes/<name>.env.

# Where node disks + the downloaded base images live (libvirt dir pool "zbnodes").
POOL_NAME=zbnodes
POOL_DIR=/var/lib/libvirt/images/zbnodes

# libvirt network the nodes attach to (NAT; nodes only need outbound — the
# tunnel to frps is outbound, devs reach IDE/SSH through Dana).
LIBVIRT_NET=default

# Node VM image (com/node "proxmox" target = qcow2) from the CDN.
# "latest" = newest non-prerelease x64 entry in the target manifest.
# Pin to an explicit version (e.g. 1.5.10) for reproducible rebuilds.
IMAGE_MANIFEST_URL=https://cdn.zerobias.com/distributions/vm/proxmox/manifest.json
IMAGE_VERSION=latest

# Memory overcommit safety net (see host/20-memory.sh).
# zram: compressed RAM swap, fast, tried first. Disk swapfile: last resort.
ZRAM_PERCENT=25
SWAPFILE=/swap.img
SWAPFILE_SIZE=64G
