# One file per node VM. Copy this file to add a node (nodes/node-2.env, ...).
# Give every node a unique NAME and VNC_PORT.
NAME=node-1
VCPUS=4        # one node must never have more vCPUs than the host; several nodes may share them
MEMORY_GB=8    # total node RAM must fit in the host RAM (VPS providers rarely allow oversubscription)
DISK_GB=100    # thin: the disk only uses host space as the node writes data
VNC_PORT=5901  # VGA console, bound to 127.0.0.1 on the host
# NODE_IMAGE_VERSION=1.7.9   # optional: pin this node's base image (default: config.env IMAGE_VERSION)
