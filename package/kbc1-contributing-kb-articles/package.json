{
  "name": "@zerobias-org/kb-kbc1-contributing-kb-articles",
  "version": "1.0.1",
  "description": "How to add an article to the ZeroBias community knowledge base: where the articles live, how they are numbered, and the steps from scaffold to published",
  "author": "team@zerobias.com",
  "license": "ISC",
  "main": "_index.md",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/kb.git",
    "directory": "package/kbc1-contributing-kb-articles"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "images/**",
    "resources/**",
    "_index.md",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "hugo --source \"$(git rev-parse --show-toplevel)\" --contentDir \"$(pwd)\" --destination \"$(pwd)/public\"",
    "clean": "rm -rf public",
    "start": "hugo server --disableFastRender --source $(git rev-parse --show-toplevel) --contentDir $(pwd)",
    "test": "npm run build"
  },
  "zerobias": {
    "package": "zerobias.kbc1.kb",
    "import-artifact": "kb",
    "dataloader-version": "1.0.0"
  }
}
